# 复制为 .env 后填写真实值；.env 不要提交到任何仓库
# 说明文档：docs/人工参数与环境配置.md

# ===== 必填：DeepSeek API Key =====
# 获取地址：https://platform.deepseek.com -> API Keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== 可选：服务地址与模型 =====
DEEPSEEK_BASE_URL=https://api.deepseek.com
COARSE_MODEL=deepseek-flash
DEEP_MODEL=deepseek-v4-pro

# ===== 可选：端口 =====
PORT=8000
RSS_BRIDGE_PORT=8053

# ===== 可选：国外源默认代理 =====
# 只填代理软件的本地监听地址，本项目不解析订阅链接
# 示例：http://127.0.0.1:7890 或 socks5://127.0.0.1:7891
PROXY_DEFAULT_URL=

# ===== 以下参数建议在界面「设置」页修改，不要写在这里 =====
# MONTHLY_BUDGET_CNY=200
# DEEP_LIMIT_PER_RUN=10
# RUN_INTERVAL_HOURS=3
# ITEM_RETENTION_DAYS=90
